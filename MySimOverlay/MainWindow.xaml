<Window x:Class="MySimOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MySimOverlay" Height="300" Width="400"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True"
        ShowInTaskbar="False">

    <Grid>

        <Border Background="#CC000000" CornerRadius="10" 
            Width="300" Height="150" 
            HorizontalAlignment="Right" VerticalAlignment="Bottom" 
            Margin="20">

            <Grid>
                <TextBlock Text="BRAKE TRACE" Foreground="Gray" FontSize="10" Margin="10,5,0,0" VerticalAlignment="Top"/>
                
                <Canvas Name="GraphCanvas" Margin="10,20,10,10" ClipToBounds="True">

                    <Polyline Name="ThrottleLine" 
              Stroke="#00FF00" 
              StrokeThickness="2" 
              StrokeLineJoin="Round"
              Opacity="0.8"/>

                    <Polyline Name="BrakeLine" 
              Stroke="Red" 
              StrokeThickness="2" 
              StrokeLineJoin="Round"/>

                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>