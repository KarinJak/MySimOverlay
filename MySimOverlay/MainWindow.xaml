<Window x:Class="MySimOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My LMU Overlay" Height="200" Width="300"
        Icon="pack://application:,,,/app_icon.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">

    <Border Name="MainBorder" Background="#44000000" CornerRadius="5">
        <Grid>
            <TextBlock Name="DebugText" Text="" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       FontSize="14" Padding="10" Visibility="Collapsed" TextAlignment="Center"/>

            <Button Name="CloseButton" Content="X" Width="30" Height="30" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                    Background="Red" Foreground="White" FontWeight="Bold"
                    Visibility="Collapsed" Click="CloseButton_Click"/>

            <Canvas Name="GraphCanvas" Margin="10,20,10,10" ClipToBounds="True">
                <Polyline Name="ThrottleLine" Stroke="#00FF00" StrokeThickness="2" Opacity="0.8" StrokeLineJoin="Round"/>
                <Polyline Name="BrakeLine" Stroke="Red" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Canvas>
        </Grid>
    </Border>
</Window>